# ──────────────────────────────────────────────────────────
# GuIndex - Variaveis de Ambiente
# Copie este arquivo para .env e preencha seus dados.
# ──────────────────────────────────────────────────────────

# Porta do servidor (padrao: 7000)
PORT=7000

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# ── URL PUBLICA (OBRIGATORIO em producao) ──
# Defina com o dominio publico da sua instancia.
# Em dev local, deixe comentado (usa http://localhost:PORT automaticamente).
# BASE_URL=https://guindex-stremio.vercel.app

# ── Torrent Indexer ──
# URL do torrent-indexer (padrao: http://127.0.0.1:8090)
# Para self-host: https://github.com/felipemarinho97/torrent-indexer
# Docker: docker run -p 8090:7006 ghcr.io/felipemarinho97/torrent-indexer:latest
# TORRENT_INDEXER_URL=http://127.0.0.1:8090
# TORRENT_INDEXER_ENABLE_FALLBACK=true
# TORRENT_INDEXER_FALLBACK_CONCURRENCY=3
# TORRENT_INDEXER_DISABLED_INDEXERS=
# TORRENT_INDEXER_FAILURE_THRESHOLD=2
# TORRENT_INDEXER_FAILURE_COOLDOWN_MS=300000

# ── Stremio Addons (OPCIONAL) ──
# Se definir STREMIO_ADDON_SOURCES, usará este ao invés do default (Mico-Leão Dublado)
# Formato: JSON array com {name, url}
# STREMIO_ADDON_SOURCES=[{"name":"Meu Addon","url":"https://meu-addon.com"},{"name":"Outro","url":"https://outro.com"}]

# Fases de busca (orcamento por pedido, 1 s abaixo do timeout de 9 s do GuIndex no AIOStreams)
# TORRENT_INDEXER_REQUEST_BUDGET_MS=8000
# Reserva para a consulta de cache do debrid depois da busca (o /stream espera por ela ate o fim do orcamento)
# TORRENT_INDEXER_DEBRID_MARGIN_MS=1500
# Teto opcional dessa espera: com o debrid lento, responde mais cedo, sem o selo (0 = nao espera)
# TORRENT_INDEXER_DEBRID_MAX_WAIT_MS=
# TORRENT_INDEXER_CACHE_MAX_QUERIES=8
# TORRENT_INDEXER_CACHE_TIMEOUT_MS=3000
# TORRENT_INDEXER_MULTI_GRACE_MS=1500
# Janela do multi quando o cache e suficiente mas nao tem nenhum 4K
# TORRENT_INDEXER_MULTI_GRACE_NO_4K_MS=4000
# TORRENT_INDEXER_PHASE3_MIN_MS=1500
# TORRENT_INDEXER_PHASE3_MAX_QUERIES=3

# Perfil recomendado para VPS (baixa latencia)
# TORRENT_INDEXER_ENABLE_FALLBACK=true
# TORRENT_INDEXER_FALLBACK_MAX_INDEXERS=0
# TORRENT_INDEXER_FALLBACK_CONCURRENCY=2
# TORRENT_INDEXER_FALLBACK_TIMEOUT_MS=3500
# TORRENT_INDEXER_HYBRID_MIN_RESULTS=2
# TORRENT_INDEXER_HYBRID_MIN_INDEXERS=2
# TORRENT_INDEXER_DISABLED_INDEXERS=
# TORRENT_INDEXER_FAILURE_THRESHOLD=2
# TORRENT_INDEXER_FAILURE_COOLDOWN_MS=300000
# TORRENT_INDEXER_GLOBAL_QUEUE_CONCURRENCY=1
# TORRENT_INDEXER_GLOBAL_QUEUE_DELAY_MS=1500
# TORRENT_INDEXER_SEARCH_CACHE_TTL_MS=120000
# TORRENT_INDEXER_INDEXERS_CACHE_TTL_MS=120000
# TORRENT_INDEXER_SOURCES_TIMEOUT_MS=1500
# TORRENT_INDEXER_LOCALIZED_TITLE_CACHE_TTL_MS=604800000
# TORRENT_INDEXER_LOCALIZED_TITLE_FAILURE_TTL_MS=300000
# TORRENT_INDEXER_TMDB_TIMEOUT_MS=5000

# Localizacao de titulos via TMDB (usa imdbId -> nome pt-BR)
# Informe ao menos um dos dois: token de leitura OU api key.
# TMDB_API_READ_ACCESS_TOKEN=
# TMDB_API_KEY=

# ── Fontes extras de addon (opcional) ──
# JSON array com objetos {"name":"...","url":"..."}
# STREMIO_ADDON_SOURCES=[{"name":"Addon Exemplo","url":"https://addon-exemplo.com"}]

# ── Stremio manifest signature (opcional) ──
# Se definido, o manifesto expõe issuer/signature.
# STREMIO_ISSUER=https://stremio-addons.net
# STREMIO_SIGNATURE=...

# ── TorBox (avancado) ──
# TORBOX_WAIT_VIDEO_URL=
# TORBOX_STREAM_LIMIT=15
# TORBOX_CHECKCACHED_TIMEOUT_MS=15000

# ── Token debrid do dono (instancia privada) ──
# Sem token na URL, so usa estes tokens com ALLOW_ENV_DEBRID_TOKEN=true.
# Atencao: os links /resolve levam o token, entao qualquer um que acesse
# /stream passa a usar esta conta. Deixe desligado em instancia publica.
# ALLOW_ENV_DEBRID_TOKEN=false
# TORBOX_TOKEN=
# REALDEBRID_TOKEN=

# ── Modo privado ──
# Com a chave definida, so pedidos com /torbox/<CHAVE>/... (ou ?key=<CHAVE>)
# funcionam; o resto e 404, inclusive /configure. Os links levam a chave e o
# token acima fica so aqui. Gere com: openssl rand -hex 24
# ADDON_ACCESS_KEY=
